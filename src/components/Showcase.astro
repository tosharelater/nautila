---
import { type Lang, tr } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const bars = [28, 44, 38, 56, 49, 67, 58, 74, 63, 82, 71, 88, 79, 68, 91, 76, 84, 72, 93, 80];
const features = tr<string[]>(lang, 'pillars.03.points');
---

<section class="section wash" id="tech">
  <div class="container showcase-grid">
    <div class="showcase-copy">
      <p class="kicker" data-fade>{tr(lang, 'showcase.kicker')}</p>
      <h2 class="section-title" data-fade data-parallax="0.06">{tr(lang, 'showcase.title')}</h2>
      <p class="section-lead" data-fade>{tr(lang, 'showcase.text')}</p>

      <ul class="showcase-features">
        {features.map((f) => (
          <li data-fade>
            <span class="feat-dot" aria-hidden="true"></span>
            {f}
          </li>
        ))}
      </ul>
    </div>

    <div class="showcase-visual" data-fade data-parallax="0.1" data-parallax-x="20" data-parallax-y="12">
      <div class="panel" data-tilt>
        <div class="panel-top">
          <span class="panel-dot"></span>
          <span class="panel-dot"></span>
          <span class="panel-dot"></span>
          <span class="panel-title">{tr(lang, 'showcase.panel.title')}</span>
        </div>

        <div class="panel-kpis">
          <div class="panel-kpi">
            <span class="kpi-label">{tr(lang, 'showcase.panel.revenue')}</span>
            <span class="kpi-value">{tr(lang, 'showcase.panel.revenue.value')}</span>
            <span class="kpi-delta">▲ {tr(lang, 'showcase.panel.revenue.delta')}</span>
          </div>
          <div class="panel-kpi">
            <span class="kpi-label">{tr(lang, 'showcase.panel.trust')}</span>
            <span class="kpi-value">{tr(lang, 'showcase.panel.trust.value')}</span>
            <span class="kpi-delta ok">● live</span>
          </div>
        </div>

        <div class="chart" data-chart role="img" aria-label={tr(lang, 'showcase.panel.series')}>
          {bars.map((h, i) => (
            <span class="chart-bar" style={`--h:${h}%; --i:${i};`}></span>
          ))}
        </div>

        <div class="panel-alert">
          <strong>{tr(lang, 'showcase.panel.alert')}</strong>
          <span>{tr(lang, 'showcase.panel.alert.text')}</span>
        </div>

        <p class="panel-foot">{tr(lang, 'showcase.panel.latency')} · 24 h · {tr(lang, 'showcase.panel.uptime')} 87 %</p>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(30px, 5vw, 72px);
  }

  .showcase-features {
    margin-top: 26px;
    display: grid;
    gap: 12px;
  }

  .showcase-features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
    color: var(--ink-700);
  }

  .feat-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand-grad);
    flex-shrink: 0;
  }

  .panel {
    padding: clamp(20px, 2.5vw, 28px);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-lg);
    display: grid;
    gap: 18px;
    transform-style: preserve-3d;
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .panel-top {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .panel-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--surface-2);
  }
  .panel-dot:nth-child(1) { background: #A6543C; }
  .panel-dot:nth-child(2) { background: #63A6A0; }
  .panel-dot:nth-child(3) { background: #63A6A0; }

  .panel-title {
    margin-left: 8px;
    font-size: 0.78rem;
    color: var(--ink-300);
    letter-spacing: 0.04em;
  }

  .panel-kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .panel-kpi {
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--hairline);
    display: grid;
    gap: 4px;
  }

  .kpi-label {
    font-size: 0.72rem;
    color: var(--ink-300);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .kpi-value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }

  .kpi-delta {
    font-size: 0.78rem;
    font-weight: 600;
    color: #2E7D8C;
  }

  .chart {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 140px;
    padding: 14px 12px 0;
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, rgba(46, 125, 140, 0.16), rgba(99, 166, 160, 0.06));
    border: 1px solid var(--hairline);
  }

  .chart-bar {
    flex: 1;
    height: 8%;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, var(--green-400), var(--green-600));
    opacity: 0.35;
    transition: height 0.9s var(--ease-out), opacity 0.6s;
    transition-delay: calc(var(--i) * 28ms);
  }

  .chart.is-on .chart-bar {
    height: var(--h);
    opacity: calc(0.4 + var(--i) * 0.025);
  }

  .panel-alert {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: rgba(46, 125, 140, 0.1);
    border: 1px solid rgba(46, 125, 140, 0.2);
    font-size: 0.86rem;
  }

  .panel-alert strong {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-900);
  }

  .panel-alert span {
    color: var(--ink-700);
  }

  .panel-foot {
    font-size: 0.78rem;
    color: var(--ink-300);
    text-align: right;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
