---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="section cta-section" id="cta">
  <div class="container">
    <div class="cta-band" data-fade>
      <div class="cta-particle-stage" aria-hidden="true">
        <canvas class="cta-particles" data-particle-text data-text="Nautila"></canvas>
      </div>

      <div class="cta-orbits" aria-hidden="true">
        <span class="c-orbit"></span>
        <span class="c-orbit c2"></span>
      </div>

      <p class="kicker" data-fade>Nautila</p>
      <h2 data-fade data-parallax="0.05">{t(lang, 'cta.title')}</h2>
      <p class="cta-lead" data-fade>{t(lang, 'cta.text')}</p>

      <div class="cta-actions" data-fade>
        <a class="btn btn-light btn-lg" href="mailto:hello@nautila.ma">
          {t(lang, 'cta.button')} <span class="arrow">→</span>
        </a>
        <span class="cta-note">{t(lang, 'cta.note')}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-bottom: 70px;
  }

  .cta-band {
    position: relative;
  }

  .cta-orbits {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .c-orbit {
    position: absolute;
    width: min(48vw, 420px);
    height: min(48vw, 420px);
    border-radius: 50%;
    border: 1px solid rgba(99, 166, 160, 0.18);
    top: -20%;
    left: -8%;
    animation: drift 22s ease-in-out infinite alternate;
  }

  .c-orbit.c2 {
    width: min(36vw, 300px);
    height: min(36vw, 300px);
    top: auto;
    left: auto;
    right: -6%;
    bottom: -18%;
    animation-duration: 16s;
    animation-direction: alternate-reverse;
  }

  @keyframes drift {
    from {
      transform: translate(0, 0) rotate(0deg);
    }
    to {
      transform: translate(18px, -24px) rotate(12deg);
    }
  }

  .cta-lead {
    margin: 18px auto 0;
    max-width: 52ch;
    font-size: 1.06rem;
  }

  .btn-lg {
    padding: 17px 34px;
    font-size: 1.04rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .c-orbit {
      animation: none;
    }
  }
</style>

<script>
  import { createParticleText } from '../scripts/particle-text';

  const canvas = document.querySelector('[data-particle-text]') as HTMLCanvasElement | null;
  if (canvas) {
    try {
      createParticleText(canvas, canvas.dataset.text || 'Nautila', {
        color: '#63A6A0',
        accent: '#F2EFE6',
      });
    } catch {
      /* decorative only */
    }
  }
</script>
