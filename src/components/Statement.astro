---
import { type ImgKey, img, srcset } from '../data/media';

interface Props {
  kicker: string;
  quote: string;
  image: ImgKey;
  sign?: string;
}
const { kicker, quote, image, sign } = Astro.props;
---

<section class="stm" data-stm>
  <div class="stm-media" aria-hidden="true">
    <img src={img(image, 1600)} srcset={srcset(image)} sizes="100vw" alt="" loading="lazy" decoding="async" data-pimg="16" />
  </div>
  <div class="stm-shade" aria-hidden="true"></div>
  <div class="container stm-inner">
    <p class="kicker">{kicker}</p>
    <blockquote class="section-title stm-q">{quote}</blockquote>
    {sign && <p class="stm-sign">{sign}</p>}
  </div>
</section>

<style>
  .stm {
    position: relative;
    min-height: 110vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: #14333b;
    color: #f2efe6;
    padding-block: 120px;
  }

  .stm-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .stm-media img {
    position: absolute;
    inset: -10% 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
  }

  .stm-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 30% 50%, rgba(20, 51, 59, 0.85), rgba(20, 51, 59, 0.55) 70%),
      linear-gradient(180deg, #14333b 0%, transparent 20%, transparent 80%, #14333b 100%);
  }

  .stm-inner {
    position: relative;
  }

  .stm .kicker {
    color: #63a6a0;
  }

  .stm .kicker::before {
    background: #63a6a0;
  }

  .stm-q {
    font-family: var(--font-display);
    margin-top: 26px;
    max-width: 22ch;
    color: #f2efe6;
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 4.4rem);
    line-height: 1.12;
  }

  .stm-q :global(.scrub-word) {
    opacity: 0.18;
  }

  .stm-q :global(.scrub-word.lit) {
    opacity: 1;
  }

  .stm-sign {
    margin-top: 34px;
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #63a6a0;
  }
</style>
