---
import { type Lang } from '../i18n/ui';
import { type PageKey, href } from '../i18n/routes';

interface Props {
  lang: Lang;
  page?: PageKey;
}
const { lang, page = 'home' } = Astro.props;
---

<div class="lang-switch" role="group" aria-label="Language / Langue">
  <a href={href('fr', page)} hreflang="fr" aria-current={lang === 'fr' ? 'true' : undefined} class:list={[{ active: lang === 'fr' }]}>FR</a>
  <a href={href('en', page)} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined} class:list={[{ active: lang === 'en' }]}>EN</a>
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    padding: 4px;
    gap: 2px;
    border-radius: 999px;
    background: rgba(242, 239, 230, 0.08);
    border: 1px solid rgba(242, 239, 230, 0.12);
  }

  .lang-switch a {
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(242, 239, 230, 0.6);
    transition: color 0.25s, background 0.25s;
  }

  .lang-switch a:hover {
    color: #f2efe6;
  }

  .lang-switch a.active {
    color: #fff;
    background: var(--brand-grad-deep);
  }
</style>
