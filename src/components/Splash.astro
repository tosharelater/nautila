---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const words =
  lang === 'en'
    ? ['Trust', 'Yield', 'Technology']
    : ['Confiance', 'Rendement', 'Technologie'];
---

<div
  class="splash"
  data-splash
  role="dialog"
  aria-label={lang === 'en' ? 'Nautila intro' : 'Intro Nautila'}
  data-words={JSON.stringify(words)}
  data-finale="Nautila"
>
  <canvas class="splash-canvas" data-splash-canvas aria-hidden="true"></canvas>
  <button class="splash-skip" type="button" data-splash-skip>
    {lang === 'en' ? 'Skip' : 'Passer'}
  </button>
</div>

<style is:global>
  html.splash-lock,
  html.splash-lock body {
    overflow: hidden;
    height: 100%;
  }

  .splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: linear-gradient(165deg, #14333B 0%, #14333B 45%, #1b424b 100%);
    transition: opacity 0.65s var(--ease-out), visibility 0.65s;
  }

  .splash.is-out {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .splash-skip {
    position: absolute;
    bottom: 28px;
    right: 28px;
    z-index: 2;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(242, 239, 230, 0.7);
    border: 1px solid rgba(242, 239, 230, 0.18);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(8px);
    transition: color 0.25s, background 0.25s, border-color 0.25s;
  }

  .splash-skip:hover {
    color: #F2EFE6;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(242, 239, 230, 0.35);
  }
</style>

<script>
  import { createSplash } from '../scripts/splash';

  const root = document.querySelector('[data-splash]') as HTMLElement | null;
  const canvas = document.querySelector('[data-splash-canvas]') as HTMLCanvasElement | null;
  if (!root || !canvas) {
    /* no-op */
  } else {
    let words: string[] = ['Confiance', 'Rendement', 'Technologie'];
    try {
      words = JSON.parse(root.dataset.words || '[]');
    } catch {
      /* keep defaults */
    }

    const handle = createSplash(root, canvas, {
      words,
      finale: root.dataset.finale || 'Nautila',
      color: '#63A6A0',
      accent: '#F2EFE6',
    });

    const skip = () => handle?.skip();
    root.querySelector('[data-splash-skip]')?.addEventListener('click', skip);
    /* Escape only — Space/Enter were too easy to trigger accidentally */
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        skip();
      }
    });
  }
</script>
