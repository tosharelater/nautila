---
import { type Lang, tr } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

type Metric = { value: number; prefix: string; suffix: string; label: string };
const metrics = tr<Metric[]>(lang, 'metrics.items');
---

<section class="section" id="metrics">
  <div class="container">
    <p class="kicker" data-fade>{tr(lang, 'metrics.kicker')}</p>
    <h2 class="section-title" data-fade data-parallax="0.05">{tr(lang, 'metrics.title')}</h2>

    <div class="stat-band" data-fade>
      {metrics.map((m) => (
        <div class="stat">
          <span class="stat-value" data-counter data-prefix={m.prefix} data-suffix={m.suffix} data-target={m.value}>
            {m.prefix}0{m.suffix}
          </span>
          <span class="stat-label">{m.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
