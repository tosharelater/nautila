---
import type { Lang } from '../i18n/ui';
import { type PageKey, href, LABELS } from '../i18n/routes';
import { type ImgKey, img, srcset } from '../data/media';

interface Props {
  lang: Lang;
  page: PageKey;
  kicker: string;
  title: string[]; // one entry per line; the last line is accented
  lead: string;
  image: ImgKey;
}
const { lang, page, kicker, title, lead, image } = Astro.props;
---

<section class="ph-hero" data-ph>
  <div class="ph-media" aria-hidden="true">
    <img src={img(image, 1600)} srcset={srcset(image)} sizes="100vw" alt="" fetchpriority="high" data-ph-img />
  </div>
  <div class="ph-shade" aria-hidden="true"></div>
  <svg class="ph-spiral" viewBox="-66 -5 172 110" fill="none" aria-hidden="true">
    <path
      pathLength="1"
      d="M100 0 A100 100 0 0 1 0 100 A61.8 61.8 0 0 1 -61.8 38.2 A38.2 38.2 0 0 1 -23.61 0 A23.61 23.61 0 0 1 0 23.61 A14.59 14.59 0 0 1 -14.59 38.2"
    ></path>
  </svg>

  <div class="container ph-inner" data-ph-inner>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={href(lang, 'home')}>{LABELS.home[lang]}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{LABELS[page][lang]}</span>
    </nav>
    <p class="kicker ph-kicker">{kicker}</p>
    <h1 class="ph-title">
      {
        title.map((line, i) => (
          <span class="ph-line">
            <span class:list={['ph-line-in', { accent: i === title.length - 1 && title.length > 1 }]} style={`--d:${0.25 + i * 0.12}s`}>
              {line}
            </span>
          </span>
        ))
      }
    </h1>
    <p class="ph-lead">{lead}</p>
  </div>

  <div class="ph-scroll" aria-hidden="true"><span></span></div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-ph]');
  const im = document.querySelector<HTMLElement>('[data-ph-img]');
  const inner = document.querySelector<HTMLElement>('[data-ph-inner]');
  if (hero && im && inner && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const upd = () => {
      const r = hero.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / r.height));
      im.style.transform = `translate3d(0, ${p * 22}%, 0) scale(${1.08 + p * 0.12})`;
      inner.style.transform = `translate3d(0, ${p * -60}px, 0)`;
      inner.style.opacity = String(1 - p * 1.4);
    };
    addEventListener('scroll', upd, { passive: true });
    upd();
  }
</script>

<style>
  .ph-hero {
    position: relative;
    min-height: 92vh;
    min-height: 92svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #14333b;
    color: #f2efe6;
    padding-bottom: clamp(60px, 10vh, 110px);
  }

  .ph-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    animation: ph-zoom 2.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    will-change: transform;
  }

  @keyframes ph-zoom {
    from {
      scale: 1.2;
      filter: blur(8px) brightness(0.7);
    }
  }

  .ph-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 51, 59, 0.55) 0%, rgba(20, 51, 59, 0.2) 35%, rgba(20, 51, 59, 0.88) 100%),
      linear-gradient(90deg, rgba(20, 51, 59, 0.6), transparent 60%);
  }

  .ph-spiral {
    position: absolute;
    right: -6%;
    top: 12%;
    width: min(60vw, 760px);
    stroke: #63a6a0;
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.5;
    pointer-events: none;
  }

  .ph-spiral path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ph-draw 3s 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes ph-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .ph-inner {
    position: relative;
    will-change: transform;
  }

  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: rgba(242, 239, 230, 0.6);
    animation: ph-fade 1s 0.1s both;
  }

  .crumbs a:hover {
    color: #f2efe6;
  }

  .ph-kicker {
    margin-top: 26px;
    color: #63a6a0;
    animation: ph-fade 1s 0.2s both;
  }

  .ph-kicker::before {
    background: #63a6a0;
  }

  .ph-title {
    margin-top: 18px;
    color: #f2efe6;
    font-weight: 400;
    font-size: clamp(2.8rem, 8vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .ph-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .ph-line-in {
    display: inline-block;
    animation: ph-rise 1.2s var(--d) cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .ph-line-in.accent {
    color: #63a6a0;
    font-weight: 500;
  }

  @keyframes ph-rise {
    from {
      transform: translateY(110%) rotate(3deg);
    }
  }

  .ph-lead {
    margin-top: 26px;
    max-width: 48ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: rgba(242, 239, 230, 0.8);
    animation: ph-fade 1.2s 0.7s both;
  }

  @keyframes ph-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .ph-scroll {
    position: absolute;
    right: clamp(24px, 5vw, 60px);
    bottom: clamp(40px, 8vh, 80px);
    width: 1px;
    height: 80px;
    background: rgba(242, 239, 230, 0.2);
    overflow: hidden;
  }

  .ph-scroll span {
    position: absolute;
    left: 0;
    width: 1px;
    height: 30px;
    background: #63a6a0;
    animation: ph-scroll 2s ease-in-out infinite;
  }

  @keyframes ph-scroll {
    from {
      top: -30px;
    }
    to {
      top: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ph-media img,
    .ph-spiral path,
    .crumbs,
    .ph-kicker,
    .ph-line-in,
    .ph-lead,
    .ph-scroll span {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
