---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const SPIRAL =
  'M100 0 A100 100 0 0 1 0 100 A61.8 61.8 0 0 1 -61.8 38.2 A38.2 38.2 0 0 1 -23.61 0 A23.61 23.61 0 0 1 0 23.61 A14.59 14.59 0 0 1 -14.59 38.2 A9 9 0 0 1 -5.6 29.2';
const tess = [
  { x: 6, y: 18, s: 54, r: 0, d: 0 },
  { x: 44, y: 10, s: 38, r: 90, d: 1.2 },
  { x: 30, y: 74, s: 46, r: 180, d: 2.1 },
  { x: 88, y: 14, s: 42, r: 270, d: 0.6 },
  { x: 92, y: 70, s: 60, r: 90, d: 1.8 },
  { x: 62, y: 84, s: 34, r: 0, d: 2.6 },
];
---

<section class="hero" id="top" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>
  <canvas class="hero-gl" data-hero-gl aria-hidden="true"></canvas>

  <div class="hero-art" aria-hidden="true" data-parallax="0.1" data-parallax-x="-30" data-parallax-y="20">
    <svg class="big-spiral" viewBox="-70 -8 176 116" fill="none">
      <defs>
        <linearGradient id="spiral-grad" x1="100" y1="0" x2="-60" y2="100" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#63A6A0"></stop>
          <stop offset="1" stop-color="#2E7D8C"></stop>
        </linearGradient>
      </defs>
      <g class="squares" stroke="#63A6A0" stroke-width="0.35" opacity="0.35">
        <rect x="0" y="0" width="100" height="100" pathLength="1"></rect>
        <rect x="-61.8" y="38.2" width="61.8" height="61.8" pathLength="1"></rect>
        <rect x="-61.8" y="0" width="38.2" height="38.2" pathLength="1"></rect>
        <rect x="-23.61" y="0" width="23.61" height="23.61" pathLength="1"></rect>
        <rect x="-14.59" y="23.61" width="14.59" height="14.59" pathLength="1"></rect>
      </g>
      <path class="spiral-glow" pathLength="1" d={SPIRAL} stroke="#63A6A0" stroke-width="7" stroke-linecap="round"></path>
      <path class="spiral-line" pathLength="1" d={SPIRAL} stroke="url(#spiral-grad)" stroke-width="3.2" stroke-linecap="round"></path>
      <circle class="spiral-dot" r="2.2" fill="#F2EFE6">
        <animateMotion dur="9s" repeatCount="indefinite" calcMode="linear" path={SPIRAL}></animateMotion>
      </circle>
    </svg>
  </div>

  <div class="tess" aria-hidden="true">
    {
      tess.map((o) => (
        <svg
          class="tess-item"
          style={`left:${o.x}%;top:${o.y}%;width:${o.s}px;height:${o.s}px;--r:${o.r}deg;animation-delay:${o.d}s`}
          viewBox="-66 -5 172 110"
          fill="none"
        >
          <path
            d="M100 0 A100 100 0 0 1 0 100 A61.8 61.8 0 0 1 -61.8 38.2 A38.2 38.2 0 0 1 -23.61 0 A23.61 23.61 0 0 1 0 23.61"
            stroke="#63A6A0"
            stroke-width="7"
            stroke-linecap="round"
          />
        </svg>
      ))
    }
  </div>

  <div class="container hero-inner">
    <p class="kicker" data-fade data-parallax="0.05">{t(lang, 'hero.kicker')}</p>
    <h1 class="hero-title" data-parallax="0.12" data-parallax-x="28" data-parallax-y="18">
      <span class="line">{t(lang, 'hero.title.a')}</span>
      <span class="line accent">{t(lang, 'hero.title.b')}</span>
    </h1>
    <p class="hero-text" data-fade data-parallax="0.06">{t(lang, 'hero.text')}</p>
    <div class="hero-actions" data-fade>
      <a class="btn btn-primary" href="#contact" data-nav-link>
        {t(lang, 'hero.cta')} <span class="arrow">→</span>
      </a>
      <a class="btn btn-outline" href="#services" data-nav-link>{t(lang, 'hero.cta.secondary')}</a>
    </div>
  </div>

  <aside class="float-card" aria-hidden="true">
    <span class="fc-label">{lang === 'en' ? 'Monthly report · October' : 'Rapport mensuel · octobre'}</span>
    <span class="fc-value">28 450 <small>MAD</small></span>
    <span class="fc-row"><b>87 %</b> {lang === 'en' ? 'occupancy' : 'occupation'} <em>+12,4 %</em></span>
  </aside>

  <svg class="waves" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <path class="w w1" d="M-100 80 C 240 20, 480 140, 720 80 S 1200 20, 1540 80 V160 H-100Z"></path>
    <path class="w w2" d="M-100 100 C 300 50, 500 150, 760 100 S 1180 60, 1540 100 V160 H-100Z"></path>
    <path class="w w3" d="M-100 125 C 260 90, 520 160, 800 125 S 1200 100, 1540 125 V160 H-100Z"></path>
  </svg>

  <div class="hero-foot container">
    <p class="hero-note" data-fade>{t(lang, 'hero.stats.line')}</p>
    <div class="scroll-hint" aria-hidden="true">
      <span>{t(lang, 'hero.scroll')}</span>
      <span class="scroll-line"></span>
    </div>
  </div>
</section>

<script>
  const host = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-gl]');
  if (host && canvas) {
    import('../scripts/hero3d')
      .then(({ createHero3D }) => {
        createHero3D(canvas, host);
        requestAnimationFrame(() => host.classList.add('gl-on'));
      })
      .catch(() => {
        /* SVG spiral fallback stays visible */
      });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--nav-h) + 20px);
    padding-bottom: 34px;
    overflow: hidden;
    background: #14333b;
    color: #f2efe6;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(60% 55% at 78% 45%, rgba(46, 125, 140, 0.45), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, rgba(99, 166, 160, 0.16), transparent 70%);
  }

  .hero-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero.gl-on .hero-gl {
    opacity: 1;
  }

  .hero.gl-on .hero-art,
  .hero.gl-on .tess,
  .hero.gl-on .hero-glow {
    display: none;
  }

  .hero-inner::before {
    content: '';
    position: absolute;
    inset: -60px -40px -60px -80px;
    z-index: -1;
    background: radial-gradient(60% 60% at 30% 50%, rgba(20, 51, 59, 0.55), transparent 75%);
    pointer-events: none;
  }

  .hero-art {
    position: absolute;
    z-index: -2;
    right: -4vw;
    top: 50%;
    width: min(62vw, 900px, 120svh);
    transform: translateY(-42%);
    pointer-events: none;
  }

  .big-spiral {
    width: 100%;
    height: auto;
    overflow: visible;
    animation: spiral-breathe 9s ease-in-out infinite;
  }

  .spiral-line,
  .spiral-glow,
  .squares rect {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 3.6s 0.4s var(--ease-out) forwards;
  }

  .squares rect {
    animation-duration: 2.4s;
    animation-delay: 0.2s;
  }

  .spiral-glow {
    opacity: 0.16;
    filter: blur(5px);
  }

  .spiral-dot {
    filter: drop-shadow(0 0 6px #63a6a0);
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes spiral-breathe {
    0%,
    100% {
      transform: rotate(-1.5deg) scale(1);
    }
    50% {
      transform: rotate(1.5deg) scale(1.025);
    }
  }

  .tess {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .tess-item {
    position: absolute;
    opacity: 0.16;
    transform: rotate(var(--r));
    animation: tess-float 11s ease-in-out infinite;
  }

  @keyframes tess-float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--r));
    }
    50% {
      transform: translateY(-16px) rotate(var(--r));
    }
  }

  .hero-inner {
    position: relative;
  }

  .hero .kicker {
    color: #63a6a0;
  }

  .hero .kicker::before {
    background: #63a6a0;
  }

  .hero-title {
    color: #f2efe6;
    font-weight: 400;
    font-size: clamp(3rem, 7.6vw, 6.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-top: 24px;
    max-width: 11ch;
    will-change: transform;
  }

  .hero-title .line {
    display: block;
  }

  .hero-title .accent {
    color: #63a6a0;
    font-weight: 500;
  }

  .hero-text {
    margin-top: 28px;
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: rgba(242, 239, 230, 0.78);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .btn-outline {
    color: #f2efe6;
    border: 1px solid rgba(242, 239, 230, 0.35);
  }

  .btn-outline:hover {
    background: rgba(242, 239, 230, 0.1);
  }

  .float-card {
    position: absolute;
    right: max(24px, 8vw);
    top: 22%;
    display: grid;
    gap: 6px;
    padding: 20px 24px;
    min-width: 240px;
    border-radius: 18px;
    background: rgba(242, 239, 230, 0.08);
    border: 1px solid rgba(242, 239, 230, 0.18);
    backdrop-filter: blur(16px);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    animation: card-float 7s ease-in-out infinite;
  }

  @keyframes card-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -12px;
    }
  }

  .fc-label {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #63a6a0;
  }

  .fc-value {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 2rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .fc-value small {
    font-size: 0.8rem;
    font-weight: 400;
    color: rgba(242, 239, 230, 0.6);
  }

  .fc-row {
    font-size: 0.85rem;
    color: rgba(242, 239, 230, 0.7);
    font-variant-numeric: tabular-nums;
  }

  .fc-row b {
    color: #f2efe6;
    font-weight: 600;
  }

  .fc-row em {
    font-style: normal;
    font-weight: 600;
    color: #63a6a0;
    margin-left: 8px;
  }

  .waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 150px;
    z-index: -1;
    pointer-events: none;
  }

  .w {
    animation: wave 12s ease-in-out infinite alternate;
  }
  .w1 {
    fill: rgba(46, 125, 140, 0.25);
  }
  .w2 {
    fill: rgba(99, 166, 160, 0.18);
    animation-duration: 16s;
    animation-direction: alternate-reverse;
  }
  .w3 {
    fill: #ffffff;
    animation-duration: 20s;
  }

  @keyframes wave {
    from {
      transform: translateX(-3%);
    }
    to {
      transform: translateX(3%);
    }
  }

  .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-top: auto;
    padding-top: 60px;
    position: relative;
  }

  .hero-note {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(242, 239, 230, 0.6);
  }

  .scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(242, 239, 230, 0.6);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(180deg, #63a6a0, transparent);
    animation: scroll-pulse 1.8s var(--ease-out) infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(0.7);
      transform-origin: top;
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line,
    .big-spiral,
    .tess-item,
    .float-card,
    .w {
      animation: none;
    }
    .spiral-line,
    .spiral-glow,
    .squares rect {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 700px) {
    .hero.gl-on .hero-gl {
      opacity: 0.55;
    }
  }

  @media (max-width: 900px) {
    .hero-art {
      width: 120vw;
      right: -30vw;
      opacity: 0.55;
    }
    .float-card,
    .scroll-hint {
      display: none;
    }
    .hero-foot {
      margin-top: 48px;
    }
  }
</style>
