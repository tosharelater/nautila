---
import { type Lang, t } from '../i18n/ui';
import ShellLogo from './ShellLogo.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const links = [
  { href: '#services', label: lang === 'en' ? 'Services' : 'Services' },
  { href: '#process', label: lang === 'en' ? 'Method' : 'Méthode' },
  { href: '#report', label: lang === 'en' ? 'Report' : 'Rapport' },
  { href: '#zones', label: lang === 'en' ? 'Areas' : 'Zones' },
  { href: '#estimate', label: lang === 'en' ? 'Simulator' : 'Simulateur' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="brand" href={lang === 'en' ? `${base}en/` : base} aria-label="Nautila — home">
      <ShellLogo size={28} color="#2E7D8C" />
      <span class="word">Nautila</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href} data-nav-link>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      <LangSwitch lang={lang} />
      <a class="btn btn-primary nav-cta" href="#contact" data-nav-link>{t(lang, 'nav.cta')}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: min(var(--container), 100%);
    height: 62px;
    padding: 0 10px 0 18px;
    border-radius: 999px;
    background: rgba(20, 51, 59, 0.55);
    border: 1px solid rgba(242, 239, 230, 0.12);
  backdrop-filter: blur(14px) saturate(1.3);
  -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: var(--shadow-sm);
    transition: background 0.4s, box-shadow 0.4s;
  }

  .nav.scrolled .nav-inner {
    background: rgba(20, 51, 59, 0.88);
    box-shadow: 0 10px 40px rgba(20, 51, 59, 0.25);
  }

  .nav-inner :global(svg path) {
    stroke: #63a6a0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #f2efe6;
  }

  .word .dot {
    background: var(--brand-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav-links {
    display: flex;
    gap: 2px;
  }

  .nav-links a {
    padding: 9px 15px;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: rgba(242, 239, 230, 0.75);
    transition: background 0.25s, color 0.25s;
  }

  .nav-links a:hover {
    background: rgba(242, 239, 230, 0.08);
    color: #f2efe6;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-cta {
    padding: 10px 20px;
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .nav-cta {
      display: none;
    }
  }
</style>
